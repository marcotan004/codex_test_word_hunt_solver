{
  "name": "client",
  "projectType": "application",
  "sourceRoot": "client/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "client",
        "command": "npm run dev"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "client",
        "command": "npm run build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "client",
        "command": "npm run test"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "client",
        "command": "npm run lint"
      }
    }
  }
}
